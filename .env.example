MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=appstore_applications_monitoring
MYSQL_USER=appmon
MYSQL_PASSWORD=replace-with-random-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
# Enable behind HTTPS (including TLS termination at a reverse proxy).
APPMON_COOKIE_SECURE=false
APPMON_ALLOWED_HOSTS=localhost,127.0.0.1
APPMON_WEB_PORT=8765
APPMON_FRONTEND_PORT=5173
# Use 0.0.0.0 to publish the frontend on a server; API and MySQL remain loopback-only.
APPMON_BIND_ADDRESS=127.0.0.1
# Optional collector proxy. Docker Desktop example: http://host.docker.internal:7897
# Leave empty when the container can reach all store endpoints directly.
APPMON_HTTP_PROXY=
APPMON_HTTPS_PROXY=
# Optional read-only Apple Ads Platform search-popularity integration (not legacy orgId).
APPLE_ADS_ACCESS_TOKEN=
APPLE_ADS_AD_ACCOUNT_ID=
