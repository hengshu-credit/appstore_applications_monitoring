OCEANBASE_HOST=127.0.0.1
OCEANBASE_PORT=2881
OCEANBASE_DATABASE=appstore_applications_monitoring
OCEANBASE_USER=root@appmon
OCEANBASE_PASSWORD=
OCEANBASE_ROOT_PASSWORD=
OCEANBASE_SYS_PASSWORD=
# Initial OceanBase data-file capacity (existing volumes require ALTER SYSTEM).
OCEANBASE_DATAFILE_SIZE=15G
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=appmon
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Enable behind HTTPS (including TLS termination at a reverse proxy).
APPMON_COOKIE_SECURE=false
APPMON_ALLOWED_HOSTS=localhost,127.0.0.1
APPMON_WEB_PORT=8765
APPMON_FRONTEND_PORT=5173
# Use 0.0.0.0 to publish the frontend on a server; API and storage remain loopback-only.
APPMON_BIND_ADDRESS=127.0.0.1
# Optional collector proxy. Docker Desktop example: http://host.docker.internal:7897
# Leave empty when the container can reach all store endpoints directly.
APPMON_HTTP_PROXY=
APPMON_HTTPS_PROXY=
# Optional read-only Apple Ads Platform search-popularity integration (not legacy orgId).
APPLE_ADS_ACCESS_TOKEN=
APPLE_ADS_AD_ACCOUNT_ID=

# Optional host directory for SeaweedFS objects; empty/unset uses a named volume.
# SEAWEEDFS_DATA_DIR=C:/Users/Administrator/AppData/Local/Appmon/seaweedfs
